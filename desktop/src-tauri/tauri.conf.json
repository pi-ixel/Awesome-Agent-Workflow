{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AAW Desktop",
  "version": "0.1.66",
  "identifier": "com.aaw.desktop",
  "build": {
    "beforeDevCommand": "node scripts/dev-doctor.mjs --fix && npm run workflow:build:debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run workflow:build && npm run ops:fetch && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AAW 桌面客户端",
        "decorations": false,
        "dragDropEnabled": false,
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../workflow-engine-rs/dist/": "workflow-engine/",
      "../ops-sidecar/dist/": "ops-sidecar/"
    },
    "windows": {
      "nsis": {
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
