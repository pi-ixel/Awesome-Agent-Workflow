{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tool-runtime",
  "description": "允许工具窗口调用自身的宿主动作",
  "local": false,
  "remote": {
    "urls": [
      "http://aaw-tool.*/*",
      "aaw-tool://*/*"
    ]
  },
  "windows": [
    "tool-*"
  ],
  "permissions": [
    "aaw-tool-runtime:allow-tool-act"
  ]
}
