  "ask#11": {
   "kind": "agent",
   "actor": "任务实现与测试",
   "prompt": "实现当前任务并执行实际验证，返回变更及证据；不得越过任务范围。",
   "knowledgeFiles": [
    "host-tools.md",
    "task-implementation.md"
   ],
   "schema": {
    "type": "object",
    "properties": {
     "status": {
      "enum": [
       "ready"
      ]
     },
     "reference": {
      "type": "string"
     },
     "evidence": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "reference",
     "evidence"
    ],
    "additionalProperties": true
   },
   "ui": {
    "label": "实现与测试",
    "steps": [
     "实现当前任务",
     "执行验证并留证"
    ]
   },
   "requires": [
    {
     "condition": {
      "any": [
       {
        "eq": [
         {
          "path": "/vars/taskIndex"
         },
         0
        ]
       },
       {
        "all": [
         {
          "eq": [
           {
            "get": [
             {
              "path": "/vars/previousDelivery"
             },
             "status"
            ]
           },
           "ready"
          ]
         },
         {
          "nonempty": {
           "get": [
            {
             "path": "/vars/previousDelivery"
            },
            "plan"
           ]
          }
         },
         {
          "nonempty": {
           "get": [
            {
             "path": "/vars/previousDelivery"
            },
            "tests"
           ]
          }
         },
         {
          "nonempty": {
           "get": [
            {
             "path": "/vars/previousDelivery"
            },
            "evidence"
           ]
          }
         },
         {
          "eq": [
           {
            "get": [
             {
              "path": "/vars/previousDelivery"
             },
             "done"
            ]
           },
           false
          ]
         },
         {
          "eq": [
           {
            "get": [
             {
              "path": "/vars/previousDelivery"
             },
             "nextTaskId"
            ]
           },
           {
            "path": "/vars/task/id"
           }
          ]
         }
        ]
       }
      ]
     },
     "message": "上一个任务的交付结果未确认当前任务可以执行"
    }
   ]
  },
