  "ask#1": {
   "kind": "agent",
   "actor": "需求确认",
   "prompt": "确认需求及边界，必要时在当前会话提问。需要用户决策时在当前会话提问并等待答复；完成确认后再提交结果。给出确认后需求及证据。",
   "knowledgeFiles": [
    "host-tools.md",
    "dev-init.md"
   ],
   "schema": {
    "type": "object",
    "properties": {
     "status": {
      "enum": [
       "ready"
      ]
     },
     "reference": {
      "type": "string"
     },
     "evidence": {
      "type": "string"
     }
    },
    "required": [
